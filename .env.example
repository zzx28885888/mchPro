# 中文/English：基础设施参数 / Infrastructure connection and host-port settings.
# 中文/English：启动前请在私有 .env 中填写随机密钥；此示例留空以确保复制后不能直接启动。
# 中文：可按 README 中的说明生成独立密钥；不要把实际密钥提交到版本库。
# English: Fill random secrets in a private .env before startup; these values are blank so a copied example cannot start as-is.
# English: Generate independent values as described in README and never commit real secrets.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# 中文/English：浏览器访问端口 / Host ports exposed by Docker Compose.
AGENT_PORT=8000
BACKEND_PORT=8080

# 中文：本地 Ollama 模式。选择此模式时，容器通过 host.docker.internal 访问宿主机 Ollama。
# English: Local Ollama mode. The container reaches the host Ollama service through host.docker.internal.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

# 中文：可选远程 OpenAI 兼容模型；设 LLM_PROVIDER=remote 后必须配置 URL、Key 和模型名。
# English: Optional remote OpenAI-compatible model; when LLM_PROVIDER=remote, URL, key, and model are required.
# Example: https://api.openai.com/v1 or https://api.deepseek.com/v1
REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=

# 中文/English：后端到 Agent 的网络地址 / Backend-to-Agent URL for non-container local runs.
AGENT_SERVICE_URL=http://localhost:8000
# 中文/English：Python 调用 Java 工具的读取超时（默认 75 秒）/ Python read timeout for Java tool calls (75 seconds by default).
JAVA_TOOL_HTTP_TIMEOUT=75
# 中文：后端与 Agent 的服务间共享令牌。复制到私有 .env 后替换为随机长串。
# English: Shared backend/Agent service token. Replace with a long random value in the private .env file.
AGENT_INTERNAL_TOKEN=
# 中文：JWT 签名密钥，至少 32 字节，只放私有 .env，不能提交到仓库。
# English: JWT signing secret, at least 32 bytes; keep it only in private .env and never commit it.
JWT_SECRET=

# 中文/English：API 固定窗口限流默认值；部署时可按访问模式调整 / API fixed-window rate-limit defaults; tune for the deployment's traffic pattern.
RATE_LIMIT_REGISTRATION_MAX_REQUESTS=5
RATE_LIMIT_REGISTRATION_WINDOW=1h
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_TASKS_MAX_REQUESTS=10
RATE_LIMIT_TASKS_WINDOW=1m

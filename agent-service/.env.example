LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=

# DeepSeek Harness: optional, isolated from the business Agent.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_HOME=.dsh-home

# V1.6 Java Tool Registry
JAVA_TOOL_REGISTRY_URL=http://localhost:8080/internal/agent/tools
JAVA_TOOL_PRINCIPAL=langgraph
# 中文/English：读取超时需大于 Java 工具的最长 60 秒执行时间 / Read timeout must exceed the Java tools' 60-second maximum execution time.
JAVA_TOOL_HTTP_TIMEOUT=75
# 中文/English：必须与 Spring 的 AGENT_INTERNAL_TOKEN 相同；在私有 .env 中填写随机值 / Required shared value matching Spring's AGENT_INTERNAL_TOKEN; set a random value in the private .env.
AGENT_INTERNAL_TOKEN=
